//- section
mixin section-desc()
  section.section.section-desc#section-desc
    .wrap__inner
      .section-desc__table.js-animate.js-animate--fadein-down.js-animate--delay500
        .section-desc__tr
          .section-desc__th
            h3.noto-700 專案期間
          .section-desc__td
            .section-desc__content.noto-300 2024/4/1-2024/12/31
        .section-desc__tr
          .section-desc__th
            h3.noto-700 專案對象
          .section-desc__td
            .section-desc__content.noto-300
              .text 永豐銀行專案薪轉公司員工之家屬
              .text (限配偶及子女)
        .section-desc__tr
          .section-desc__th
            h3.noto-700 專案內容
          .section-desc__td
            .section-desc__content.noto-300 家屬須於永豐銀行開戶並經申請核准後可享以下優惠
        .section-desc__tr.tr-4
          .section-desc__th
            h3.noto-700 利率與自動化設備
            h3.noto-700 手續費優惠次數
          .section-desc__td
            .section-desc__content.noto-300
              .line-clamp| 指定帳戶與員工薪轉帳戶相同之優惠利率
              br
              .line-clamp| 指定帳戶與員工薪轉帳戶相同之自動化設備手續費優惠次數
        .section-desc__tr.tr-5
          .section-desc__th.noto-700
            h3 網銀換匯減分優惠
            h3.min-text (以新臺幣結購外幣)
          //- 客製化表格
          .section-desc__td
            .desc-table-1
              .desc-tr
                .desc-th.round-1 幣別
                .desc-td.round-2 減分
              .desc-tr
                .desc-th 美元
                .desc-td 3分
              .desc-tr
                .desc-th 人民幣
                .desc-td 0.63分
              .desc-tr
                .desc-th 日圓
                .desc-td 0.06分
              .desc-tr
                .desc-th 歐元
                .desc-td 6分
              .desc-tr
                .desc-th.round-3 港幣
                .desc-td.round-4 0.9分
        .section-desc__tr.tr-6
          .section-desc__th.noto-700
            h3 精選基金定時定額
            h3 新申購手續費優惠
          .section-desc__td
            .desc-table-2
              .wrap-tr-2
                .desc-tr-2
                  .desc-th-2.round-1
                    span 單次
                    span 扣款金額
                  .desc-td-2.round-2
                    span 申購
                    span 手續費
                .desc-tr-2
                  .wrap-th-2
                    .desc-th-2 NTD 10,000
                      br
                      | (含)以下
                    .desc-th-2.round-5 USD 300(含)
                      br
                      | 以下
                  .desc-td-2.round-6 0元
              .wrap-tr-2
                .desc-tr-2.d-none
                  .desc-th-2.round-1
                    span 單次
                    span 扣款金額
                  .desc-td-2.round-2
                    span 申購
                    span 手續費
                .desc-tr-2
                  .wrap-th-2
                    .desc-th-2 逾NTD
                      br
                      | 10,000
                    .desc-th-2.round-3 逾NTD
                      br
                      | 300
                  .desc-td-2.round-4 全額38折





